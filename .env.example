# ==============================================================================
# 95 STAR TRACKING - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Netlify / Client)
# ------------------------------------------------------------------------------
# VITE_API_URL: The public base URL of your deployed backend on Render.
# Example: https://star-tracking-backend.onrender.com
# If left empty, API requests will use relative paths (e.g., when hosted together).
VITE_API_URL=""

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render / Node.js Server)
# ------------------------------------------------------------------------------
# PORT: Listening port for the Express server (Render automatically sets this to 10000).
PORT=3000

# NODE_ENV: Set to 'production' in your production deployment.
NODE_ENV="production"

# APP_URL: The public URL of your tracking web app (used to generate email tracking links).
# Example: https://your-app.vercel.app
APP_URL=""

# ALLOWED_ORIGIN: CORS allowed origin for frontend requests.
# Set to "*" or your Vercel domain (e.g., "https://your-app.vercel.app")
ALLOWED_ORIGIN="*"

# DISABLE_FIRESTORE: Set to "true" to run standalone disk/memory database without Firebase or Google Cloud billing.
DISABLE_FIRESTORE="true"

# ADMIN AUTHENTICATION: Credentials for accessing the Admin Operations Dashboard.
ADMIN_EMAIL="hassanmehdi1444@gmail.com"
ADMIN_PASSWORD="YourSecurePasswordHere"

# ------------------------------------------------------------------------------
# EMAIL SERVICE (Resend - Optional / Free Tier)
# ------------------------------------------------------------------------------
# RESEND_API_KEY: API key for automated email delivery of driver & passenger tracking links.
# Get a free API key at https://resend.com
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Sender email address for automated tracking notifications.
# Example: "95 Star Tracking <onboarding@resend.dev>" or "95 Star Tracking <dispatch@yourdomain.com>"
RESEND_FROM_EMAIL="95 Star Tracking <onboarding@resend.dev>"
