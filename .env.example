# ==============================================================================
# 95 STAR TRACKING - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Netlify / Client)
# ------------------------------------------------------------------------------
# VITE_API_URL: The public base URL of your deployed backend on Render.
# Example: https://star-tracking-backend.onrender.com
# If left empty, API requests will use relative paths (e.g., when hosted together).
VITE_API_URL=""

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render / Node.js Server)
# ------------------------------------------------------------------------------
# PORT: Listening port for the Express server (Render automatically sets this to 10000).
PORT=3000

# NODE_ENV: Set to 'production' in your production deployment.
NODE_ENV="production"

# APP_URL: The public URL of your tracking web app (used to generate email tracking links).
# Example: https://your-app.vercel.app
APP_URL=""

# ALLOWED_ORIGIN: CORS allowed origin for frontend requests.
# Set to "*" or your Vercel domain (e.g., "https://your-app.vercel.app")
ALLOWED_ORIGIN="*"

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL (Persistent Source of Truth)
# ------------------------------------------------------------------------------
# SUPABASE_URL: Your Supabase project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: The secret service_role key for server-side PostgreSQL access.
# NEVER expose this key to the frontend or git.
SUPABASE_SERVICE_ROLE_KEY=""

# DATABASE_URL (Optional): Direct PostgreSQL connection string if connecting via pg pooler.
DATABASE_URL=""

# DISABLE_FIRESTORE: Set to "true" to run with Supabase without Google Cloud or Firebase billing.
DISABLE_FIRESTORE="true"

# ADMIN AUTHENTICATION: Credentials for accessing the Admin Operations Dashboard.
# ------------------------------------------------------------------------------
# RESEND EMAIL SERVICE CONFIGURATION (Render / Production Environment)
# ------------------------------------------------------------------------------
# RESEND_API_KEY: Secret API key from https://resend.com
# Example: re_123456789_abcdefg
# NEVER expose this key in frontend code or client network requests.
RESEND_API_KEY=""

# EMAIL_FROM: Verified sender email address (also supports RESEND_FROM_EMAIL).
# For testing: "95 Star Tracking <onboarding@resend.dev>" (sandbox, sends to account email)
# For production: "95 Star Tracking <dispatch@yourdomain.com>" (requires domain verification in Resend)
EMAIL_FROM="95 Star Tracking <onboarding@resend.dev>"
RESEND_FROM_EMAIL="95 Star Tracking <onboarding@resend.dev>"

# ADMIN_EMAIL: Primary administrative recipient address for new ride alerts and tracking links.
# Example: "admin@95startracking.com"
ADMIN_EMAIL="hassanmehdi1444@gmail.com"
ADMIN_PASSWORD="YourSecurePasswordHere"

